{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/app/books/[id]",
      "regex": "^/app/books/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/app/books/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/app/books/[id]/export",
      "regex": "^/app/books/([^/]+?)/export(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/app/books/(?<nxtPid>[^/]+?)/export(?:/)?$"
    },
    {
      "page": "/dictionary/[category]",
      "regex": "^/dictionary/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPcategory": "nxtPcategory"
      },
      "namedRegex": "^/dictionary/(?<nxtPcategory>[^/]+?)(?:/)?$"
    },
    {
      "page": "/dictionary/[category]/[concept]",
      "regex": "^/dictionary/([^/]+?)/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPcategory": "nxtPcategory",
        "nxtPconcept": "nxtPconcept"
      },
      "namedRegex": "^/dictionary/(?<nxtPcategory>[^/]+?)/(?<nxtPconcept>[^/]+?)(?:/)?$"
    },
    {
      "page": "/languages/[code]",
      "regex": "^/languages/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPcode": "nxtPcode"
      },
      "namedRegex": "^/languages/(?<nxtPcode>[^/]+?)(?:/)?$"
    }
  ],
