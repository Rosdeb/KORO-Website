card/95 pb-[env(safe-area-inset-bottom)] backdrop-blur-md md:hidden\"><a class=\"flex min-h-14 select-none flex-col items-center justify-center gap-0.5 px-0.5 text-[10px] sm:text-[11px] font-medium transition-colors active:bg-muted text-muted-foreground\" href=\"/\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-house size-4.5 sm:size-5 transition-transform\" aria-hidden=\"true\"><path d=\"M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8\"></path><path d=\"M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"></path></svg><span class=\"truncate max-w-full text-center\">Home</span></a><a class=\"flex min-h-14 select-none flex-col items-center justify-center gap-0.5 px-0.5 text-[10px] sm:text-[11px] font-medium transition-colors active:bg-muted text-muted-foreground\" href=\"/languages\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-languages size-4.5 sm:size-5 transition-transform\" aria-hidden=\"true\"><path d=\"m5 8 6 6\"></path><path d=\"m4 14 6-6 2-3\"></path><path d=\"M2 5h12\"></path><path d=\"M7 2h1\"></path><path d=\"m22 22-5-10-5 10\"></path><path d=\"M14 18h6\"></path></svg><span class=\"truncate max-w-full text-center\">Languages</span></a><a class=\"flex min-h-14 select-none flex-col items-center justify-center gap-0.5 px-0.5 text-[10px] sm:text-[11px] font-medium transition-colors active:bg-muted text-muted-foreground\" href=\"/app/submissions/new\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-message-square-plus size-4.5 sm:size-5 transition-transform\" aria-hidden=\"true\"><path d=\"M22 17a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.414.586l-2.202 2.202A.71.71 0 0 1 2 21.286V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2z\"></path><path d=\"M12 8v6\"></path><path d=\"M9 11h6\"></path></svg><span class=\"truncate max-w-full text-center\">Suggest</span></a><a class=\"flex min-h-14 select-none flex-col items-center justify-center gap-0.5 px-0.5 text-[10px] sm:text-[11px] font-medium transition-colors active:bg-muted text-muted-foreground\" href=\"/dictionary\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-book-open size-4.5 sm:size-5 transition-transform\" aria-hidden=\"true\"><path d=\"M12 5v16\"></path><path d=\"M20.001 19A2 2 0 0022 17V5a2 2 0 00-1.999-2L16 3.002A5 5 0 0012 5a5 5 0 00-4-2H4a2 2 0 00-2 2v12a2 2 0 001.999 2H8a5 5 0 014 2 5 5 0 014-2z\"></path></svg><span class=\"truncate max-w-full text-center\">Dictionary</span></a><a class=\"flex min-h-14 select-none flex-col items-center justify-center gap-0.5 px-0.5 text-[10px] sm:text-[11px] font-medium transition-colors active:bg-muted text-muted-foreground\" href=\"/search\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-search size-4.5 sm:size-5 transition-transform\" aria-hidden=\"true\"><path d=\"m21 21-4.34-4.34\"></path><circle cx=\"11\" cy=\"11\" r=\"8\"></circle></svg><span class=\"truncate max-w-full text-center\">Search</span></a><button type=\"button\" aria-label=\"More navigation options\" class=\"flex min-h-14 select-none flex-col items-center justify-center gap-0.5 px-0.5 text-[10px] sm:text-[11px] font-medium transition-colors active:bg-muted text-muted-foreground\" aria-haspopup=\"dialog\" aria-expanded=\"false\" data-state=\"closed\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-layout-grid size-4.5 sm:size-5 transition-transform\" aria-hidden=\"true\"><rect width=\"7\" height=\"7\" x=\"3\" y=\"3\" rx=\"1\"></rect><rect width=\"7\" height=\"7\" x=\"14\" y=\"3\" rx=\"1\"></rect><rect width=\"7\" height=\"7\" x=\"14\" y=\"14\" rx=\"1\"></rect><rect width=\"7\" height=\"7\" x=\"3\" y=\"14\" rx=\"1\"></rect></svg><span class=\"truncate max-w-full text-center\">More</span></button></nav></div><script>requestAnimationFrame(function(){$RT=performance.now()});</script><script src=\"/_next/static/chunks/webpack-7ff8cd1ddc62d350.js\" id=\"_R_\" async=\"\"></script><div hidden id=\"S:0\"><div><section class=\"relative overflow-hidden border-b border-border bg-muted/30\"><div class=\"pointer-events-none absolute inset-0 select-none overflow-hidden\"><span class=\"script-bn absolute -left-6 top-8 text-7xl text-foreground/5\">ক</span><span class=\"script-mya absolute right-10 top-4 text-8xl text-foreground/5\">က</span><span class=\"script-bn absolute bottom-6 left-1/4 text-6xl text-foreground/5\">ভ</span><span class=\"script-mya absolute bottom-4 right-1/3 text-7xl text-foreground/5\">ဂ</span></div><div class=\"container-koro relative z-10 grid gap-10 py-20 sm:py-28 lg:grid-cols-[1.2fr_0.8fr] lg:items-center lg:gap-16\"><div><p class=\"text-xs font-semibold uppercase tracking-widest text-muted-foreground\">About Korot</p><h1 class=\"mt-5 max-w-2xl text-4xl font-bold leading-tight tracking-tight sm:text-5xl lg:text-6xl\">A home for words. A connection to culture.</h1><p class=\"mt-6 max-w-xl text-base leading-relaxed text-muted-foreground\">Korot helps people discover, learn, and preserve language knowledge. We bring words, meanings, and translations together, with a focus on indigenous languages and the communities that keep them alive.</p><div class=\"mt-8 flex flex-wrap gap-3\"><a class=\"inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md font-medium transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background disabled:pointer-events-none disabled:opacity-50 cursor-pointer bg-accent text-accent-foreground hover:bg-accent-hover h-11 px-6 text-base\" href=\"/dictionary\">Explore Dictionary<!-- --> <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right size-4\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a><a class=\"inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md font-medium transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background disabled:pointer-events-none disabled:opacity-50 cursor-pointer border border-border bg-transparent hover:bg-muted text-foreground h-11 px-6 text-base\" href=\"/languages\">Explore Languages</a></div></div><div class=\"rounded-xl border border-border bg-card p-6 sm:p-8\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-earth size-7 text-accent\" aria-hidden=\"true\"><path d=\"M21.54 15H17a2 2 0 0 0-2 2v4.54\"></path><path d=\"M7 3.34V5a3 3 0 0 0 3 3a2 2 0 0 1 2 2c0 1.1.9 2 2 2a2 2 0 0 0 2-2c0-1.1.9-2 2-2h3.17\"></path><path d=\"M11 21.95V18a2 2 0 0 0-2-2a2 2 0 0 1-2-2v-1a2 2 0 0 0-2-2H2.05\"></path><circle cx=\"12\" cy=\"12\" r=\"10\"></circle></svg><h2 class=\"mt-5 text-lg font-semibold\">More than a word and its meaning</h2><p class=\"mt-3 text-sm leading-relaxed text-muted-foreground\">A language connects people to family, place, and tradition. Making that knowledge easier to find gives more people a way to learn, share, and stay connected to it.</p><div class=\"mt-6 border-t border-border pt-5\"><p class=\"text-sm font-medium\">Open to explore. Built with community.</p><p class=\"mt-2 text-sm text-muted-foreground\">Start with a familiar word. Discover where it takes you.</p></div></div></div></section><section class=\"border-b border-border bg-muted/40\"><div class=\"container-koro py-14 sm:py-20\"><p class=\"text-xs font-semibold uppercase tracking-widest text-muted-foreground\">Our values</p><h2 class=\"mt-3 text-2xl font-bold tracking-tight sm:text-3xl\">Language knowledge belongs within reach.</h2><div class=\"mt-10 grid gap-5 sm:grid-cols-3\"><div class=\"relative rounded-xl border border-border bg-card p-6\"><span class=\"absolute right-5 top-5 text-4xl font-black tabular-nums text-muted-foreground/10\">0<!-- -->1</span><div class=\"flex size-10 items-center justify-center rounded-lg bg-accent/10\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-earth size-5 text-accent\" aria-hidden=\"true\"><path d=\"M21.54 15H17a2 2 0 0 0-2 2v4.54\"></path><path d=\"M7 3.34V5a3 3 0 0 0 3 3a2 2 0 0 1 2 2c0 1.1.9 2 2 2a2 2 0 0 0 2-2c0-1.1.9-2 2-2h3.17\"></path><path d=\"M11 21.95V18a2 2 0 0 0-2-2a2 2 0 0 1-2-2v-1a2 2 0 0 0-2-2H2.05\"></path><circle cx=\"12\" cy=\"12\" r=\"10\"></circle></svg></div><h3 class=\"mt-5 font-semibold\">Every language matters</h3><p class=\"mt-2 text-sm leading-relaxed text-muted-foreground\">Languages carry stories, identity, and everyday knowledge. Korot makes space for languages and communities that are often underrepresented online.</p></div><div class=\"relative rounded-xl border border-border bg-card p-6\"><span class=\"absolute right-5 top-5 text-4xl font-black tabular-nums text-muted-foreground/10\">0<!-- -->2</span><div class=\"flex size-10 items-center justify-center rounded-lg bg-accent/10\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-users size-5 text-accent\" aria-hidden=\"true\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"></path><path d=\"M16 3.128a4 4 0 0 1 0 7.744\"></path><path d=\"M22 21v-2a4 4 0 0 0-3-3.87\"></path><circle cx=\"9\" cy=\"7\" r=\"4\"></circle></svg></div><h3 class=\"mt-5 font-semibold\">Knowledge grows together</h3><p class=\"mt-2 text-sm leading-relaxed text-muted-foreground\">Speakers and learners bring different perspectives. By suggesting translations, the community helps make language knowledge more useful and accessible.</p></div><div class=\"relative rounded-xl border border-border bg-card p-6\"><span class=\"absolute right-5 top-5 text-4xl font-black tabular-nums text-muted-foreground/10\">0<!-- -->3</span><div class=\"flex size-10 items-center justify-center rounded-lg bg-accent/10\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shield-check size-5 text-accent\" aria-hidden=\"true\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path><path d=\"m9 12 2 2 4-4\"></path></svg></div><h3 class=\"mt-5 font-semibold\">Care in every contribution</h3><p class=\"mt-2 text-sm leading-relaxed text-muted-foreground\">Suggested translations go through review. Pending contributions are kept distinct from reviewed entries, so learners can understand what they are reading.</p></div></div></div></section><section class=\"border-b border-border\"><div class=\"container-koro py-14 sm:py-20\"><p class=\"text-xs font-semibold uppercase tracking-widest text-muted-foreground\">Getting started</p><h2 class=\"mt-3 text-2xl font-bold tracking-tight sm:text-3xl\">Follow your curiosity.</h2><div class=\"mt-10 grid gap-6 sm:grid-cols-3\"><div class=\"flex flex-col gap-4 rounded-xl border border-border bg-card p-6\"><div class=\"flex items-center justify-between\"><div class=\"flex size-10 items-center justify-center rounded-lg bg-muted\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-compass size-5 text-muted-foreground\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m16.24 7.76-1.804 5.411a2 2 0 0 1-1.265 1.265L7.76 16.24l1.804-5.411a2 2 0 0 1 1.265-1.265z\"></path></svg></div><span class=\"text-2xl font-black tabular-nums text-muted-foreground/20\">0<!-- -->1</span></div><div class=\"flex-1\"><h3 class=\"text-base font-semibold\">Explore</h3><p class=\"mt-2 text-sm leading-relaxed text-muted-foreground\">Browse languages and dictionary categories, or search for a word. No account needed.</p></div><a class=\"inline-flex items-center gap-1.5 text-sm font-medium text-accent hover:underline\" href=\"/languages\">Browse languages<!-- --> <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right size-3.5\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a></div><div class=\"flex flex-col gap-4 rounded-xl border border-border bg-card p-6\"><div class=\"flex items-center justify-between\"><div class=\"flex size-10 items-center justify-center rounded-lg bg-muted\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-book-open-text size-5 text-muted-foreground\" aria-hidden=\"true\"><path d=\"M12 5v16\"></path><path d=\"M16 13h2\"></path><path d=\"M16 9h2\"></path><path d=\"M20.001 19A2 2 0 0022 17V5a2 2 0 00-1.999-2L16 3.002A5 5 0 0012 5a5 5 0 00-4-2H4a2 2 0 00-2 2v12a2 2 0 001.999 2H8a5 5 0 014 2 5 5 0 014-2z\"></path><path d=\"M6 13h2\"></path><path d=\"M6 9h2\"></path></svg></div><span class=\"text-2xl font-black tabular-nums text-muted-foreground/20\">0<!-- -->2</span></div><div class=\"flex-1\"><h3 class=\"text-base font-semibold\">Learn</h3><p class=\"mt-2 text-sm leading-relaxed text-muted-foreground\">Discover meanings and translations, with pronunciation and examples where available.</p></div><a class=\"inline-flex items-center gap-1.5 text-sm font-medium text-accent hover:underline\" href=\"/dictionary\">Explore the dictionary<!-- --> <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right size-3.5\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a></div><div class=\"flex flex-col gap-4 rounded-xl border border-border bg-card p-6\"><div class=\"flex items-center justify-between\"><div class=\"flex size-10 items-center justify-center rounded-lg bg-muted\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-bookmark-plus size-5 text-muted-foreground\" aria-hidden=\"true\"><path d=\"M12 7v6\"></path><path d=\"M15 10H9\"></path><path d=\"M17 3a2 2 0 0 1 2 2v15a1 1 0 0 1-1.496.868l-4.512-2.578a2 2 0 0 0-1.984 0l-4.512 2.578A1 1 0 0 1 5 20V5a2 2 0 0 1 2-2z\"></path></svg></div><span class=\"text-2xl font-black tabular-nums text-muted-foreground/20\">0<!-- -->3</span></div><div class=\"flex-1\"><h3 class=\"text-base font-semibold\">Make it yours</h3><p class=\"mt-2 text-sm leading-relaxed text-muted-foreground\">Create an account to save words in personal books and return to what you want to learn.</p></div><a class=\"inline-flex items-center gap-1.5 text-sm font-medium text-accent hover:underline\" href=\"/register\">Create an account<!-- --> <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right size-3.5\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a></div></div></div></section><section class=\"container-koro py-14 pb-28 sm:py-20 md:pb-20\"><div class=\"grid gap-px overflow-hidden rounded-xl border border-border bg-border sm:grid-cols-2\"><div class=\"flex flex-col justify-between gap-6 bg-foreground p-8 sm:p-10\"><div><p class=\"text-xs font-semibold uppercase tracking-widest text-background/40\">The community</p><h2 class=\"mt-3 text-2xl font-bold leading-tight text-background sm:text-3xl\">Your knowledge can help someone learn.</h2><p class=\"mt-3 text-sm leading-relaxed text-background/55\">Know a translation? Want to reconnect with a language or discover a new one? There is a place for you here. Explore the dictionary, build your own books, or suggest translations for review.</p></div><a class=\"inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background disabled:pointer-events-none disabled:opacity-50 cursor-pointer h-11 px-6 text-base w-fit bg-background text-foreground hover:bg-muted font-semibold\" href=\"/register\">Join Korot<!-- --> <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right size-4\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a></div><div class=\"flex flex-col justify-between gap-6 bg-card p-8 sm:p-10\"><div><p class=\"text-xs font-semibold uppercase tracking-widest text-muted-foreground\">No sign-up needed</p><h2 class=\"mt-3 text-2xl font-bold leading-tight tracking-tight sm:text-3xl\">Start with one word.</h2><p class=\"mt-3 text-sm leading-relaxed text-muted-foreground\">Browsing is open to everyone. Create an account when you are ready to save words or contribute.</p></div><a class=\"inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md font-medium transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background disabled:pointer-events-none disabled:opacity-50 cursor-pointer border border-border bg-transparent hover:bg-muted text-foreground h-11 px-6 text-base w-fit\" href=\"/dictionary\">Explore Dictionary<!-- --> <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right size-4\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a></div></div></section></div><!--$--><!--/$--></div><script>$RB=[];$RV=function(a){$RT=performance.now();for(var b=0;b<a.length;b+=2){var c=a[b],e=a[b+1];null!==e.pa