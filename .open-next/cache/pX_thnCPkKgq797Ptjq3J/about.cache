us:outline-none focus:ring-2 focus:ring-ring focus:border-transparent h-9 text-sm cursor-pointer\" value=\"\"/></div></form></div></div><div class=\"ml-auto flex items-center gap-2\"><button aria-label=\"Search\" class=\"rounded-full p-2.5 text-foreground hover:bg-muted lg:hidden\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-search size-5\" aria-hidden=\"true\"><path d=\"m21 21-4.34-4.34\"></path><circle cx=\"11\" cy=\"11\" r=\"8\"></circle></svg></button><button aria-label=\"Toggle theme\" class=\"rounded-full p-2.5 text-foreground hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring\" type=\"button\" id=\"radix-_R_a59fdb_\" aria-haspopup=\"menu\" aria-expanded=\"false\" data-state=\"closed\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-sun size-5\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"4\"></circle><path d=\"M12 2v2\"></path><path d=\"M12 20v2\"></path><path d=\"m4.93 4.93 1.41 1.41\"></path><path d=\"m17.66 17.66 1.41 1.41\"></path><path d=\"M2 12h2\"></path><path d=\"M20 12h2\"></path><path d=\"m6.34 17.66-1.41 1.41\"></path><path d=\"m19.07 4.93-1.41 1.41\"></path></svg></button><button aria-label=\"Open menu\" class=\"rounded-full p-2.5 text-foreground hover:bg-muted md:hidden\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-menu size-5\" aria-hidden=\"true\"><path d=\"M4 5h16\"></path><path d=\"M4 12h16\"></path><path d=\"M4 19h16\"></path></svg></button></div></div></header><main class=\"flex-1\"><div><section class=\"border-b border-border bg-primary-50/60\"><div class=\"container-koro flex flex-col items-center gap-4 py-16 text-center\"><h1 class=\"text-3xl font-extrabold sm:text-4xl\">About Koro</h1><p class=\"max-w-xl text-muted-foreground\">Koro is a home for discovering, learning, and preserving language knowledge — starting with the languages and communities that need it most.</p></div></section><section class=\"container-koro py-16\"><div class=\"grid grid-cols-1 gap-6 sm:grid-cols-3\"><div class=\"rounded-2xl border border-border bg-card p-6 shadow-sm\"><div class=\"flex size-11 items-center justify-center rounded-xl bg-primary-50 text-primary\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-earth size-5\" aria-hidden=\"true\"><path d=\"M21.54 15H17a2 2 0 0 0-2 2v4.54\"></path><path d=\"M7 3.34V5a3 3 0 0 0 3 3a2 2 0 0 1 2 2c0 1.1.9 2 2 2a2 2 0 0 0 2-2c0-1.1.9-2 2-2h3.17\"></path><path d=\"M11 21.95V18a2 2 0 0 0-2-2a2 2 0 0 1-2-2v-1a2 2 0 0 0-2-2H2.05\"></path><circle cx=\"12\" cy=\"12\" r=\"10\"></circle></svg></div><h3 class=\"mt-4 font-semibold\">Every language matters</h3><p class=\"mt-1.5 text-sm text-muted-foreground\">From widely spoken languages to indigenous languages with few remaining speakers, Koro treats every language as worth discovering and preserving.</p></div><div class=\"rounded-2xl border border-border bg-card p-6 shadow-sm\"><div class=\"flex size-11 items-center justify-center rounded-xl bg-primary-50 text-primary\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-users size-5\" aria-hidden=\"true\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"></path><path d=\"M16 3.128a4 4 0 0 1 0 7.744\"></path><path d=\"M22 21v-2a4 4 0 0 0-3-3.87\"></path><circle cx=\"9\" cy=\"7\" r=\"4\"></circle></svg></div><h3 class=\"mt-4 font-semibold\">Community-powered</h3><p class=\"mt-1.5 text-sm text-muted-foreground\">Speakers and learners can suggest translations. Every contribution is reviewed before it becomes part of the official record.</p></div><div class=\"rounded-2xl border border-border bg-card p-6 shadow-sm\"><div class=\"flex size-11 items-center justify-center rounded-xl bg-primary-50 text-primary\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shield-check size-5\" aria-hidden=\"true\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path><path d=\"m9 12 2 2 4-4\"></path></svg></div><h3 class=\"mt-4 font-semibold\">Trust in every word</h3><p class=\"mt-1.5 text-sm text-muted-foreground\">Community submissions are always clearly labeled as pending until reviewed — never blended with verified translations.</p></div></div></section><section class=\"border-y border-border bg-muted/40 py-16\"><div class=\"container-koro\"><h2 class=\"text-center text-2xl font-bold\">How it works</h2><div class=\"mt-10 grid grid-cols-1 gap-6 sm:grid-cols-3\"><div class=\"flex flex-col items-center gap-3 text-center\"><div class=\"flex size-14 items-center justify-center rounded-2xl bg-card shadow-sm\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-compass size-6 text-primary\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m16.24 7.76-1.804 5.411a2 2 0 0 1-1.265 1.265L7.76 16.24l1.804-5.411a2 2 0 0 1 1.265-1.265z\"></path></svg></div><div class=\"flex items-center gap-2 text-sm font-semibold text-primary-700\"><span>1</span><span class=\"h-1 w-1 rounded-full bg-primary-700\"></span><span>Explore</span></div><p class=\"text-sm text-muted-foreground\">Browse languages and dictionary categories — no account needed.</p></div><div class=\"flex flex-col items-center gap-3 text-center\"><div class=\"flex size-14 items-center justify-center rounded-2xl bg-card shadow-sm\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-book-open-text size-6 text-primary\" aria-hidden=\"true\"><path d=\"M12 5v16\"></path><path d=\"M16 13h2\"></path><path d=\"M16 9h2\"></path><path d=\"M20.001 19A2 2 0 0022 17V5a2 2 0 00-1.999-2L16 3.002A5 5 0 0012 5a5 5 0 00-4-2H4a2 2 0 00-2 2v12a2 2 0 001.999 2H8a5 5 0 014 2 5 5 0 014-2z\"></path><path d=\"M6 13h2\"></path><path d=\"M6 9h2\"></path></svg></div><div class=\"flex items-center gap-2 text-sm font-semibold text-primary-700\"><span>2</span><span class=\"h-1 w-1 rounded-full bg-primary-700\"></span><span>Learn</span></div><p class=\"text-sm text-muted-foreground\">See translations, pronunciation, and examples for any word.</p></div><div class=\"flex flex-col items-center gap-3 text-center\"><div class=\"flex size-14 items-center justify-center rounded-2xl bg-card shadow-sm\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-bookmark-plus size-6 text-primary\" aria-hidden=\"true\"><path d=\"M12 7v6\"></path><path d=\"M15 10H9\"></path><path d=\"M17 3a2 2 0 0 1 2 2v15a1 1 0 0 1-1.496.868l-4.512-2.578a2 2 0 0 0-1.984 0l-4.512 2.578A1 1 0 0 1 5 20V5a2 2 0 0 1 2-2z\"></path></svg